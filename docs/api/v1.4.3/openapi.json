    "/reports/change-summary": {
      "get": {
        "operationId": "getChangeSummary",
        "summary": "Summarize recorded changes",
        "description": "One scope is required. Counts describe recorded events, not independently verified outages. An empty scope returns zero counts and empty period strings.",
        "tags": [
          "Reports"
        ],
        "parameters": [
          {
            "name": "area_ids",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Supply one scope. If several are given, precedence is area_ids, area_id, pi_id, rd_id, network_id. area_ids is comma-separated."
          },
          {
            "name": "area_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Supply one scope. If several are given, precedence is area_ids, area_id, pi_id, rd_id, network_id. area_ids is comma-separated."
